# Chave gratuita obtida em https://usebolsai.com/dashboard (login Google).
# Sem tickers de teste sem chave — obrigatória pra qualquer ticker.
BOLSAI_API_KEY=

# E-mail de contato exigido pela SEC EDGAR no header User-Agent (política deles,
# não é autenticação — qualquer e-mail válido serve, sem cadastro).
# https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_CONTACT_EMAIL=

# Finance API do EasyBusiness (Fase 1.7) — self-host via `docker compose up`
# no repo `easybusiness`. Base URL só precisa mudar se ela rodar em outro
# host/porta; a chave deve ser a mesma configurada em `API_KEYS` no
# `easybusiness/api/.env`.
FINANCE_API_BASE_URL=http://localhost:8000
FINANCE_API_KEY=
